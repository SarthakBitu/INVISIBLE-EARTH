{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public explorer profile with zero PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "homeBase": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Private PII isolated under user-only access.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Destination bookmarked by a specific user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "destinationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "destinationName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "destinationId", "destinationName", "savedAt"]
    },
    "SavedAdventurePlan": {
      "title": "SavedAdventurePlan",
      "description": "User-configured expedition itinerary and budget forecast.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "destinationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "destinationName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "startDate": { "type": "string", "minLength": 4, "maxLength": 20 },
        "endDate": { "type": "string", "minLength": 4, "maxLength": 20 },
        "budgetTier": { "type": "string", "enum": ["Budget", "Mid-Range", "Luxury"] },
        "partyType": { "type": "string", "enum": ["Solo", "Couple", "Friends", "Family"] },
        "estimatedTotalUsd": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "uid",
        "destinationId",
        "destinationName",
        "startDate",
        "endDate",
        "budgetTier",
        "partyType",
        "estimatedTotalUsd",
        "createdAt"
      ]
    },
    "CommunityStory": {
      "title": "CommunityStory",
      "description": "Public field story published by an authenticated verified explorer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorRole": { "type": "string", "minLength": 1, "maxLength": 60 },
        "destinationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "destinationName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "country": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "excerpt": { "type": "string", "minLength": 3, "maxLength": 240 },
        "body": { "type": "string", "minLength": 10, "maxLength": 6000 },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 350000 },
        "rating": { "type": "number" },
        "likesCount": { "type": "integer" },
        "sharedItinerarySummary": { "type": "string", "maxLength": 220 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "authorUid",
        "authorName",
        "authorRole",
        "destinationId",
        "destinationName",
        "country",
        "title",
        "excerpt",
        "body",
        "imageUrl",
        "rating",
        "likesCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoryLike": {
      "title": "StoryLike",
      "description": "One-per-user like record on a story.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "storyId", "createdAt"]
    },
    "DestinationReview": {
      "title": "DestinationReview",
      "description": "Public trail review authored by a verified explorer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "location": { "type": "string", "maxLength": 80 },
        "destinationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 3, "maxLength": 1200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorUid", "authorName", "destinationId", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public explorer profile."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII record."
    },
    "/users/{userId}/wishlist/{destinationId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "User's saved destination bookmarks."
    },
    "/users/{userId}/plans/{planId}": {
      "schema": { "$ref": "#/entities/SavedAdventurePlan" },
      "description": "User's saved adventure plans."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/CommunityStory" },
      "description": "Community expedition stories."
    },
    "/stories/{storyId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/StoryLike" },
      "description": "Per-user story likes."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/DestinationReview" },
      "description": "Community destination reviews."
    }
  }
}
